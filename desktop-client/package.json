{
  "name": "onestaff",
  "productName": "Onestaff",
  "version": "1.0.3",
  "description": "Onestaff Desktop Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.19.0",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.onestaff.app",
    "productName": "Onestaff",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lbstaff.u-u.my.id/updates/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Onestaff"
    },
    "files": [
      "main.js",
      "icon.png",
      "views/**/*"
    ]
  },
  "allowScripts": {
    "active-win@8.2.1": true,
    "uiohook-napi@1.5.5": true
  }
}
